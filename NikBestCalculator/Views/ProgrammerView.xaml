<UserControl x:Class="NikBestCalculator.Views.ProgrammerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinHeight" Value="35"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: Переключение систем -->
            <RowDefinition Height="Auto"/>   <!-- 1: Дисплей -->
            <RowDefinition Height="Auto"/>   <!-- 2: История -->
            <RowDefinition Height="Auto"/>   <!-- 3: Кнопки управления историей -->
            <RowDefinition Height="*"/>      <!-- 4: Кнопки калькулятора -->
        </Grid.RowDefinitions>

        <!-- 0: Переключение систем счисления -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <Button Content="DEC" Width="60" Command="{Binding SetDecimalCommand}" Margin="2"/>
            <Button Content="HEX" Width="60" Command="{Binding SetHexCommand}" Margin="2"/>
            <Button Content="BIN" Width="60" Command="{Binding SetBinaryCommand}" Margin="2"/>
            <Button Content="OCT" Width="60" Command="{Binding SetOctalCommand}" Margin="2"/>
        </StackPanel>

        <!-- 1: Дисплей -->
        <TextBox FontSize="28" FontWeight="Bold" HorizontalContentAlignment="Right" 
                 VerticalContentAlignment="Center" Height="50" Margin="0,0,0,5"
                 IsReadOnly="True" Text="{Binding Display}" Grid.Row="1"/>

        <!-- 2: История -->
        <Border Grid.Row="2" Height="80" Margin="0,0,0,5"
                Background="#F5F5F5" BorderBrush="#CCC" BorderThickness="1" CornerRadius="4">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding History}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" Margin="5"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#E0E0E0" 
                                    CornerRadius="4" 
                                    Margin="3" 
                                    Padding="8,4"
                                    BorderBrush="#AAA" 
                                    BorderThickness="1"
                                    MouseDown="HistoryItem_MouseDown">
                                <TextBlock Text="{Binding}" FontSize="12" Foreground="#333"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 3: Кнопки управления историей -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5,0,8">
            <Button Content="Очистить историю" Command="{Binding ClearHistoryCommand}" MinWidth="140" Height="28" Background="#E0E0E0" Padding="10,0"/>
            <TextBlock Text="(двойной клик по записи — удалить)" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- 4: Кнопки калькулятора -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Content="AND" Grid.Row="0" Grid.Column="0" Command="{Binding AndCommand}" Margin="2" MinHeight="30"/>
            <Button Content="OR" Grid.Row="0" Grid.Column="1" Command="{Binding OrCommand}" Margin="2" MinHeight="30"/>
            <Button Content="XOR" Grid.Row="0" Grid.Column="2" Command="{Binding XorCommand}" Margin="2" MinHeight="30"/>
            <Button Content="NOT" Grid.Row="0" Grid.Column="3" Command="{Binding NotCommand}" Margin="2" MinHeight="30"/>

            <Button Content="&lt;&lt;" Grid.Row="1" Grid.Column="0" Command="{Binding LeftShiftCommand}" Margin="2" MinHeight="30"/>
            <Button Content="&gt;&gt;" Grid.Row="1" Grid.Column="1" Command="{Binding RightShiftCommand}" Margin="2" MinHeight="30"/>
            <Button Content="C" Grid.Row="1" Grid.Column="2" Command="{Binding ClearCommand}" Margin="2" MinHeight="30" Background="#E53935" Foreground="White"/>
            <Button Content="=" Grid.Row="1" Grid.Column="3" Command="{Binding EqualsCommand}" Margin="2" MinHeight="30" Background="#1E88E5" Foreground="White"/>

            <Button Content="A" Grid.Row="2" Grid.Column="0" Command="{Binding HexDigitCommand}" CommandParameter="A" Margin="2" MinHeight="30"/>
            <Button Content="B" Grid.Row="2" Grid.Column="1" Command="{Binding HexDigitCommand}" CommandParameter="B" Margin="2" MinHeight="30"/>
            <Button Content="C" Grid.Row="2" Grid.Column="2" Command="{Binding HexDigitCommand}" CommandParameter="C" Margin="2" MinHeight="30"/>
            <Button Content="D" Grid.Row="2" Grid.Column="3" Command="{Binding HexDigitCommand}" CommandParameter="D" Margin="2" MinHeight="30"/>

            <Button Content="E" Grid.Row="3" Grid.Column="0" Command="{Binding HexDigitCommand}" CommandParameter="E" Margin="2" MinHeight="30"/>
            <Button Content="F" Grid.Row="3" Grid.Column="1" Command="{Binding HexDigitCommand}" CommandParameter="F" Margin="2" MinHeight="30"/>
            <Button Content="7" Grid.Row="3" Grid.Column="2" Command="{Binding NumberCommand}" CommandParameter="7" Margin="2" MinHeight="30"/>
            <Button Content="8" Grid.Row="3" Grid.Column="3" Command="{Binding NumberCommand}" CommandParameter="8" Margin="2" MinHeight="30"/>

            <Button Content="9" Grid.Row="4" Grid.Column="0" Command="{Binding NumberCommand}" CommandParameter="9" Margin="2" MinHeight="30"/>
            <Button Content="0" Grid.Row="4" Grid.Column="1" Command="{Binding NumberCommand}" CommandParameter="0" Margin="2" MinHeight="30"/>
            <Button Content="1" Grid.Row="4" Grid.Column="2" Command="{Binding NumberCommand}" CommandParameter="1" Margin="2" MinHeight="30"/>
            <Button Content="2" Grid.Row="4" Grid.Column="3" Command="{Binding NumberCommand}" CommandParameter="2" Margin="2" MinHeight="30"/>
        </Grid>
    </Grid>
</UserControl>