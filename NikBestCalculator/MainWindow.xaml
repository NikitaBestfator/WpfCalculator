<Window x:Class="NikBestCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NikBestCalculator.Views"
        Title="NikBest Calculator" Height="550" Width="550"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая панель переключения режимов -->
        <StackPanel Grid.Column="0" Background="#2C2C2C" Width="120" VerticalAlignment="Stretch" Margin="0,0,5,0">
            <TextBlock Text="Режимы" Foreground="White" FontSize="14" FontWeight="Bold" Margin="10,15,10,10" HorizontalAlignment="Center"/>
            <Button Content="Стандартный" Click="StandardMode_Click" Margin="10,5" Padding="10" Background="#3A3A3A" Foreground="White" BorderBrush="#555" BorderThickness="1"/>
            <Button Content="Инженерный" Click="EngineerMode_Click" Margin="10,5" Padding="10" Background="#3A3A3A" Foreground="White" BorderBrush="#555" BorderThickness="1"/>
            <Button Content="Программист" Click="ProgrammerMode_Click" Margin="10,5" Padding="10" Background="#3A3A3A" Foreground="White" BorderBrush="#555" BorderThickness="1"/>
        </StackPanel>

        <!-- Основная область -->
        <ContentControl x:Name="ModeContent" Grid.Column="1" Margin="5"/>
    </Grid>
</Window>